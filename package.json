{
  "name": "tv-tracker",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm build:ui && wrangler dev",
    "dev:ui": "pnpm --filter @tv-tracker/ui run dev",
    "build": "pnpm build:api && pnpm build:ui",
    "build:api": "pnpm --filter @tv-tracker/api run build",
    "build:ui": "pnpm --filter @tv-tracker/ui run build",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "pnpm -r run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.56.0",
    "wrangler": "^4.24.3"
  }
}
